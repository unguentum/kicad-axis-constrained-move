    (pad "1" thru_hole circle (at -4 0) (size 3 3) (drill 1.2) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole circle (at 4 0) (size 3 3) (drill 1.2) (layers "*.Cu" "*.Mask"))
